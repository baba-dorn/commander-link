# Public web configuration (safe to expose in the browser bundle)
VITE_API_BASE_URL=http://localhost:8788

# ---------------------------------------------------------------------------
# Worker configuration.
# METERED_REALTIME_KEY_ID and METERED_REALTIME_SECRET are SECRETS. Set them via
#   wrangler secret put METERED_REALTIME_KEY_ID
#   wrangler secret put METERED_REALTIME_SECRET
# and NEVER commit them or expose them to the browser / Electron renderer.
# ---------------------------------------------------------------------------

# Metered Dashboard -> Realtime Messaging -> Keys (secret key id)
METERED_REALTIME_KEY_ID=sk_id_replace-me

# Metered Dashboard -> Realtime Messaging -> Keys (signing secret, shown once)
METERED_REALTIME_SECRET=sk_secret_replace-me

# Deployment configuration
APP_ORIGIN=http://localhost:5173
ROOM_TTL_SECONDS=21600
TOKEN_TTL_SECONDS=3600
MAX_ROOM_PEERS=4
