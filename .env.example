# Public web configuration (safe to expose in the browser bundle)
VITE_API_BASE_URL=http://localhost:8788

# ---------------------------------------------------------------------------
# Worker configuration. METERED_SECRET_KEY is a SECRET — set it via
#   wrangler secret put METERED_SECRET_KEY
# and NEVER commit it or expose it to the browser / Electron renderer.
# ---------------------------------------------------------------------------

# Metered app subdomain: <METERED_APP_NAME>.metered.live (not a secret)
METERED_APP_NAME=your-app-name

# Metered Dashboard -> Developers -> Secret Key (server-side only)
METERED_SECRET_KEY=replace-me

# Deployment configuration
APP_ORIGIN=http://localhost:5173
ROOM_TTL_SECONDS=21600
TOKEN_TTL_SECONDS=3600
MAX_ROOM_PEERS=4
