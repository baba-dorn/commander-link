{
  "name": "@commander-link/desktop",
  "private": true,
  "version": "0.1.3",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc && electron .",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "dist:dir": "electron-builder --dir --config electron-builder.config.cjs",
    "dist:win": "pnpm build && electron-builder --win --publish never --config electron-builder.config.cjs"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "@commander-link/core": "workspace:*",
    "@types/node": "^22.0.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
